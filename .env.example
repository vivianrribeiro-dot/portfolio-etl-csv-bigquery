# Copie este arquivo para ".env" e preencha com os seus valores.
# Nunca commite o .env real (ele já está no .gitignore).

# ID do seu projeto no Google Cloud (ex: meu-projeto-etl-123456)
GCP_PROJECT_ID=

# Dataset que será criado/usado no BigQuery
BQ_DATASET=olist_ecommerce

# Caminho para o arquivo JSON da service account
# (deixe em branco se estiver usando "gcloud auth application-default login")
GOOGLE_APPLICATION_CREDENTIALS=
